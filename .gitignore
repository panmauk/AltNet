# Passwords / env / explicitly-marked secrets
donotpush*
*password*.txt
*.secret
secrets/
.env
*.env

# ── Apps kept PRIVATE — only the protocol/network is published ──
# The Studio desktop app, backend, admin app, and demo live under app/
# (singular). The public repo ships only the protocol: core/, apps/
# (plural — registrar, gateway, dns, …), and cli/. This pattern matches
# the "app" directory exactly and does NOT affect "apps".
/app/

