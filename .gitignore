*.deb
*.AppImage
*.zip
altnet-linux
altnet-backend-linux
for-dad/
build/bin/
**/build/bin/

# ── Frontend deps & generated ──
node_modules/
app/desktop/frontend/dist/
app/desktop/frontend/wailsjs/

